/* Fjerner standard margin og padding fra nettleseren */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* Grunnstil for hele nettsiden */
body {
  font-family: Arial, Helvetica, sans-serif;
  background-color: #ffffff;
  color: #111111;
}


/* HEADER */

.site-header {
  width: 100%;
  height: 64px;
  background-color: #970000;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28px;
}

/* Logo og tekst på venstre side */
.header-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

/* Logo i header */
.logo {
  width: 42px;
  height: 42px;
  object-fit: contain;
}

/* KommuneKompasset-tekst */
.brand-text h1 {
  color: white;
  font-size: 23px;
  font-weight: 700;
  line-height: 1;
}

/* Slagord under logo-teksten */
.brand-text p {
  color: white;
  font-size: 8px;
  margin-top: 4px;
}

/* Navigasjon */
.nav-menu {
  display: flex;
  align-items: center;
  gap: 24px;
}

.nav-menu a {
  color: white;
  text-decoration: none;
  font-size: 17px;
  font-weight: 500;
}

.nav-menu a:hover {
  opacity: 0.8;
}


/* FORSIDE */

.frontpage {
  background-color: white;
}

/* Toppseksjon med tittel, søk og knapp */
.hero {
  text-align: center;
  padding-top: 52px;
}

.hero h2 {
  font-size: 22px;
  font-weight: 500;
  margin-bottom: 22px;
}

/* Søkefelt */
.search-box {
  width: 280px;
  height: 34px;
  border: 1.5px solid #002b68;
  border-radius: 20px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 12px;
}

.search-icon {
  color: #002b68;
  font-size: 20px;
}

.search-box input {
  border: none;
  outline: none;
  width: 100%;
  font-size: 11px;
}

/* Sammenlign-knapp */
.compare-btn {
  margin-top: 24px;
  background-color: #002b68;
  color: white;
  border: none;
  border-radius: 18px;
  padding: 10px 18px;
  font-size: 11px;
  cursor: pointer;
}

.compare-btn:hover {
  background-color: #001f4d;
}

.compare-btn span {
  margin-left: 8px;
}

/* Kort forklarende tekst */
.intro-text {
  max-width: 650px;
  margin: 26px auto 0;
  font-size: 12px;
  line-height: 1.4;
}


/* KARTOMRÅDE */

.map-section {
  width: 100%;
  max-width: 1100px;
  min-height: 620px;
  margin: 40px auto 70px;
  display: grid;
  grid-template-columns: 230px 1fr 210px;
  gap: 20px;
  align-items: center;
}


/* FILTERBOKS */

.filter-box {
  width: 210px;
  border: 3px solid #002b68;
  border-radius: 8px;
  padding: 14px;
  background-color: white;
  align-self: start;
  margin-top: 40px;
}

.filter-box h3 {
  font-size: 22px;
  font-weight: 500;
  margin-bottom: 12px;
}

.filter-search {
  height: 24px;
  border: 1px solid #002b68;
  border-radius: 14px;
  display: flex;
  align-items: center;
  padding: 0 7px;
  margin-bottom: 13px;
}

.filter-search input {
  border: none;
  outline: none;
  width: 100%;
  font-size: 9px;
}

.filter-search span {
  color: #002b68;
  font-size: 13px;
}

.filter-box label {
  display: block;
  font-size: 11px;
  margin: 12px 0;
}

.filter-box input {
  margin-right: 6px;
}

.filter-box p {
  font-size: 9px;
  color: #999999;
  margin-top: 12px;
}


/* KART */

.map-wrapper {
  position: relative;
  width: 100%;
  height: 620px;
}

/* SVG-kartet fyller hele kartområdet */
#norwayMap {
  width: 100%;
  height: 100%;
  display: block;
}

/* Standard stil for alle kommunene */
.municipality {
  fill: #cfcfcf;
  stroke: #ffffff;
  stroke-width: 0.55;
  cursor: pointer;
  transition: fill 0.15s ease, stroke-width 0.15s ease;
}

/* Når man holder musepekeren over en kommune */
.municipality:hover {
  fill: #8f8f8f;
  stroke: #002b68;
  stroke-width: 1.4;
}

/* Kommunen som er klikket på */
.municipality.selected {
  fill: #970000;
  stroke: #002b68;
  stroke-width: 1.2;
}

/* Nabokommunene rundt valgt kommune */
.municipality.neighbor {
  fill: #00306d;
  stroke: #ffffff;
  stroke-width: 0.8;
}

/* Liten boks som viser kommunenavn ved hover */
.tooltip {
  position: absolute;
  background-color: white;
  border: 1px solid #002b68;
  border-radius: 6px;
  padding: 6px 9px;
  font-size: 11px;
  color: #002b68;
  pointer-events: none;
  opacity: 0;
  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.12);
}


/* KOMMUNEKORT TIL HØYRE */

.municipality-card {
  width: 190px;
  border: 2px solid #002b68;
  border-radius: 6px;
  padding: 20px 18px;
  background-color: white;
}

.municipality-card h3 {
  text-align: center;
  font-size: 17px;
  font-weight: 500;
  border-bottom: 1px solid #b9b9b9;
  padding-bottom: 10px;
  margin-bottom: 12px;
}

.municipality-card p {
  font-size: 11px;
  color: #999999;
  margin-bottom: 18px;
  line-height: 1.4;
}

.municipality-card button {
  background-color: #002b68;
  color: white;
  border: none;
  border-radius: 18px;
  padding: 10px 18px;
  font-size: 14px;
  cursor: pointer;
}

.municipality-card button:hover {
  background-color: #001f4d;
}


/* FOOTER */

.site-footer {
  width: 100%;
  height: 58px;
  background-color: #062b66;
  color: white;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* Midtinnhold i footer */
.footer-center {
  text-align: center;
}

.footer-brand {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  font-size: 11px;
}

.footer-brand img {
  width: 20px;
  height: 20px;
  object-fit: contain;
}

.footer-center p {
  font-size: 8px;
  margin-top: 4px;
}

/* Tekst helt til høyre i footer */
.footer-source {
  position: absolute;
  right: 28px;
  font-size: 8px;
}


/* RESPONSIV DESIGN */

@media (max-width: 900px) {
  .map-section {
    grid-template-columns: 1fr;
    justify-items: center;
  }

  .filter-box,
  .municipality-card {
    width: 85%;
    max-width: 320px;
  }

  .map-wrapper {
    height: 560px;
  }
}

@media (max-width: 600px) {
  .site-header {
    height: auto;
    padding: 14px 18px;
    flex-direction: column;
    gap: 12px;
  }

  .brand-text h1 {
    font-size: 20px;
  }

  .nav-menu a {
    font-size: 15px;
  }

  .hero {
    padding: 35px 18px 0;
  }

  .intro-text {
    font-size: 11px;
  }

  .site-footer {
    height: auto;
    padding: 16px;
    flex-direction: column;
    gap: 8px;
  }

  .footer-source {
    position: static;
  }
}
