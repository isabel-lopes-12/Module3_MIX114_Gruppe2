* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background-color: #ffffff;
  color: #111;
}

/* HEADER */

.site-header {
  width: 100%;
  height: 64px;
  background-color: #970000;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28px;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.logo {
  width: 42px;
  height: 42px;
  object-fit: contain;
}

.brand-text h1 {
  color: #ffffff;
  font-size: 21px;
  font-weight: 700;
  line-height: 1;
}

.brand-text p {
  color: #ffffff;
  font-size: 8px;
  margin-top: 4px;
  font-style: italic;
}

.nav-menu {
  display: flex;
  align-items: center;
  gap: 24px;
}

.nav-link {
  color: #ffffff;
  text-decoration: none;
  font-size: 15px;
  font-weight: 500;
  transition: opacity 0.2s ease;
}

.nav-link:hover {
  opacity: 0.75;
}

.nav-link.active {
  font-weight: 700;
}

/* FOOTER */

.site-footer {
  width: 100%;
  height: 58px;
  background-color: #062b66;
  color: #ffffff;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.footer-center {
  text-align: center;
}

.footer-brand {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  font-size: 11px;
}

.footer-logo {
  width: 20px;
  height: 20px;
  object-fit: contain;
}

.footer-center p {
  font-size: 8px;
  margin-top: 4px;
}

.footer-source {
  position: absolute;
  right: 28px;
  bottom: 18px;
  font-size: 8px;
  color: #ffffff;
}

/* RESPONSIVE */

@media (max-width: 600px) {
  .site-header {
    height: auto;
    padding: 14px 18px;
    flex-direction: column;
    gap: 12px;
  }

  .nav-menu {
    gap: 18px;
  }

  .brand-text h1 {
    font-size: 19px;
  }

  .site-footer {
    height: auto;
    padding: 16px 18px;
    flex-direction: column;
    gap: 8px;
  }

  .footer-source {
    position: static;
    font-size: 8px;
  }
}
